DATABASE_URL=mysql+pymysql://examlab:change-me@127.0.0.1:3306/examlab
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret

# Proxmox API values stay on the backend and must never be added to the frontend.
PROXMOX_API_URL=https://proxmox.example.com:8006
PROXMOX_API_TOKEN_ID=examlab@pve!exam-api
PROXMOX_API_TOKEN_SECRET=replace-with-the-proxmox-token-secret
PROXMOX_NODE=pve-node
PROXMOX_TEMPLATE_VMID=9000
PROXMOX_STORAGE=local-lvm
PROXMOX_VERIFY_SSL=true
